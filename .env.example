# Root configuration for running MCP servers from this repo.
# Copy to .env (or .env.local) and fill in secrets as needed.
#
# Notes:
# - Keep .env out of git (it contains tokens).
# - This repo is designed to work in offline/locked-down environments.
# - Local embedding models must be pre-downloaded into MODEL_ASSETS_DIR.
#


########################################
# Environment Profiles                 #
########################################
#
# LOCAL DEV:
#   LLM:       OpenAI API (gpt-4o-mini for query expansion / reranking)
#   Embedding: local-embeddings MCP server running Xenova/bge-small-en-v1.5 (384 dim)
#              exposed on http://127.0.0.1:3100/v1/embeddings
#
# PRODUCTION (target):
#   LLM:       gpt-oss-120b via enterprise OpenAI-compatible API
#   Embedding: bge-large-en-v1.5 (1024 dim) via same enterprise API
#
# The key insight: in local dev, the embedding endpoint and the LLM endpoint
# are different hosts. In production, a single API serves both.
# This is handled by OPENAI_EMBED_BASE_URL / OPENAI_EMBED_API_KEY (embedding)
# vs OPENAI_BASE_URL / OPENAI_API_KEY (LLM).


############################
# Docsearch: data locations #
############################

# Base directory for docsearch data (docs, urls.md, index.db, etc.)
DOCSEARCH_DATA_DIR=./data

# Optional: override the sqlite db path directly (default: ${DOCSEARCH_DATA_DIR}/index.db)
# DB_PATH=./data/index.db


########################################
# LLM Configuration (OpenAI-compatible)#
########################################

# Used by docsearch query expansion and reranking.
# In local dev: real OpenAI key for gpt-4o-mini.
# In production: enterprise API key for gpt-oss-120b.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM model overrides
OPENAI_QUERY_EXPANSION_MODEL=gpt-4o-mini
OPENAI_RERANK_MODEL=gpt-4o-mini

# --- PRODUCTION LLM overrides ---
# OPENAI_API_KEY=<enterprise-token>
# OPENAI_BASE_URL=<enterprise-endpoint>/v1
# OPENAI_QUERY_EXPANSION_MODEL=gpt-oss-120b
# OPENAI_RERANK_MODEL=gpt-oss-120b


########################################
# Embedding Configuration (docsearch)  #
########################################
#
# Embedding uses separate config vars (OPENAI_EMBED_*) so that the embedding
# endpoint can differ from the LLM endpoint. Falls back to OPENAI_BASE_URL
# and OPENAI_API_KEY when not set.
#
# Provider: openai | tei
EMBEDDINGS_PROVIDER=openai

# --- LOCAL DEV (default) ---
# Points to the local-embeddings HTTP server on port 3100.
OPENAI_EMBED_API_KEY=local
OPENAI_EMBED_BASE_URL=http://127.0.0.1:3100/v1
OPENAI_EMBED_MODEL=Xenova/bge-small-en-v1.5
OPENAI_EMBED_DIM=384

# --- PRODUCTION ---
# When the enterprise API serves both LLM and embedding, you can either:
#   a) Leave OPENAI_EMBED_* unset (falls back to OPENAI_BASE_URL / OPENAI_API_KEY), or
#   b) Set them explicitly:
# OPENAI_EMBED_API_KEY=<enterprise-token>
# OPENAI_EMBED_BASE_URL=<enterprise-endpoint>/v1
# OPENAI_EMBED_MODEL=bge-large-en-v1.5
# OPENAI_EMBED_DIM=1024

# TEI (Text Embeddings Inference) endpoint -- alternative to OpenAI-compatible
# TEI_ENDPOINT=http://127.0.0.1:8080/embed


##############################################
# Local-embeddings server (MCP + HTTP API)   #
##############################################

# These are used by src/local-embeddings/*
MODEL_ID=Xenova/bge-small-en-v1.5
# MODEL_ASSETS_DIR is the preferred name; MODEL_CACHE_DIR is accepted as fallback.
MODEL_ASSETS_DIR=./model-cache
MODEL_CACHE_DIR=./model-cache
EMBED_CACHE_SIZE=1000
EMBED_CONCURRENCY=2

# HTTP API (OpenAI-compatible /v1/embeddings)
EMBEDDINGS_HTTP_HOST=127.0.0.1
EMBEDDINGS_HTTP_PORT=3100


##########################
# Image-to-text (optional)
##########################

ENABLE_IMAGE_TO_TEXT=false
IMAGE_TO_TEXT_PROVIDER=openai
IMAGE_TO_TEXT_MODEL=gpt-4o-mini


#######################
# Confluence (optional)
#######################

# CONFLUENCE_BASE_URL=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# basic | bearer
# CONFLUENCE_AUTH_METHOD=basic
# Comma-separated
# CONFLUENCE_SPACES=

# Optional filters (comma-separated)
# CONFLUENCE_PARENT_PAGES=
# CONFLUENCE_TITLE_INCLUDES=
# CONFLUENCE_TITLE_EXCLUDES=


##############################
# Local file sources (docsearch)
##############################

# Comma-separated. Default is ${DOCSEARCH_DATA_DIR}/docs
# FILE_ROOTS=./data/docs

# Comma-separated glob patterns
# FILE_INCLUDE_GLOBS=**/*.{go,ts,tsx,js,py,rs,java,md,mdx,txt,yaml,yml,json,pdf,png,jpg,jpeg,gif,svg,webp}
# FILE_EXCLUDE_GLOBS=**/{.git,node_modules,dist,build,target}/**


#########################
# Fake Qdrant (vector DB)
#########################

# When enabled, exposes a Qdrant-compatible HTTP shim (in addition to MCP tools).
FAKE_QDRANT_ENABLED=0
FAKE_QDRANT_HTTP_HOST=127.0.0.1
FAKE_QDRANT_HTTP_PORT=6333
FAKE_QDRANT_DATA_DIR=./data/fake-qdrant

# Embedding provider: "local" (local-embeddings server) or "external" (OpenAI-compatible API).
FAKE_QDRANT_EMBEDDING_PROVIDER=local
# Local mode: target URL for the local-embeddings HTTP wrapper.
# FAKE_QDRANT_LOCAL_EMBEDDINGS_TARGET=http://127.0.0.1:3100
# External mode: base URL and model name.
# FAKE_QDRANT_EMBEDDING_BASE_URL=<enterprise-endpoint>
# FAKE_QDRANT_EMBEDDING_MODEL=bge-large-en-v1.5


#####################
# central-mcp server #
#####################

PORT=3300
# Semicolon-separated on Windows, colon-separated on Unix
# FILESYSTEM_ALLOWED_DIRS=C:\\DEVHOME\\GITHUB


################
# Memory server #
################

# MEMORY_FILE_PATH=./data/memory.json
