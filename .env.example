# Root configuration for running MCP servers from this repo.
# Copy to .env (or .env.local). Keep secrets out of git.
#
# Locked-down Windows default (this repo):
#   - JSON/JSONL storage only (no SQLite)
#   - Docsearch EMBEDDINGS_PROVIDER=local (in-process Transformers.js)
#   - Optional HTTP sidecars: embeddings :3100, fake-qdrant :6333
#   - Model weights in MODEL_CACHE_DIR / MODEL_ASSETS_DIR (not committed)

########################################
# Environment Profiles                 #
########################################
#
# DEFAULT (offline-first):
#   Docsearch embeds in-process with Xenova/all-MiniLM-L6-v2 (384 dim).
#   local-embeddings MCP is optional (custom vectors / HTTP sidecar).
#
# OPTIONAL (OpenAI-compatible embedder, shared by docsearch and fake-qdrant):
#   python scripts/setup_roo.py --embeddings external
#   Uses OPENAI_EMBED_* below. Fake-qdrant also accepts FAKE_QDRANT_EMBEDDING_*
#   fallbacks if you need to override one server only.
#


############################
# Docsearch: data locations #
############################

# This repo's Roo setup uses ./data/docsearch (docs/, urls.md, index/).
DOCSEARCH_DATA_DIR=./data/docsearch

# JSON index directory (default: ${DOCSEARCH_DATA_DIR}/index). Not a .db file.
# DB_PATH=./data/docsearch/index


########################################
# LLM Configuration (OpenAI-compatible)#
########################################

# Used by optional query expansion / reranking (not required for local search).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_QUERY_EXPANSION_MODEL=gpt-4o-mini
# OPENAI_RERANK_MODEL=gpt-4o-mini


########################################
# Embedding Configuration (docsearch)  #
########################################
#
# Provider: local | openai | tei
EMBEDDINGS_PROVIDER=local
LOCAL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
LOCAL_EMBED_DIM=384
LOCAL_MODEL_CACHE_DIR=./model-cache

# Optional: OpenAI-compatible HTTP (intranet API or local-embeddings sidecar)
# One block is enough for both central-docsearch and central-fake-qdrant.
# EMBEDDINGS_PROVIDER=openai
# OPENAI_EMBED_API_KEY=
# OPENAI_EMBED_BASE_URL=https://server.com/v1/openai
# OPENAI_EMBED_MODEL=bge-m3
# OPENAI_EMBED_DIM=1024

# Local-embeddings sidecar (384-d MiniLM) instead of the intranet API:
# OPENAI_EMBED_API_KEY=local
# OPENAI_EMBED_BASE_URL=http://127.0.0.1:3100/v1
# OPENAI_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# OPENAI_EMBED_DIM=384

# TEI_ENDPOINT=http://127.0.0.1:8080/embed


##############################################
# Local-embeddings server (MCP + HTTP API)   #
##############################################

# These are used by src/local-embeddings/*
MODEL_ID=Xenova/all-MiniLM-L6-v2
# MODEL_ASSETS_DIR is the preferred name; MODEL_CACHE_DIR is accepted as fallback.
MODEL_ASSETS_DIR=./model-cache
MODEL_CACHE_DIR=./model-cache
EMBED_CACHE_SIZE=1000
EMBED_CONCURRENCY=2

# HTTP API (OpenAI-compatible /v1/embeddings)
EMBEDDINGS_HTTP_HOST=127.0.0.1
EMBEDDINGS_HTTP_PORT=3100


##########################
# Image-to-text (optional)
##########################

# Native sharp is stubbed (vendor/sharp-stub). Leave this false.
ENABLE_IMAGE_TO_TEXT=false
IMAGE_TO_TEXT_PROVIDER=openai
IMAGE_TO_TEXT_MODEL=gpt-4o-mini


#######################
# Confluence (optional)
#######################

# CONFLUENCE_BASE_URL=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# basic | bearer
# CONFLUENCE_AUTH_METHOD=basic
# Comma-separated
# CONFLUENCE_SPACES=

# Optional filters (comma-separated)
# CONFLUENCE_PARENT_PAGES=
# CONFLUENCE_TITLE_INCLUDES=
# CONFLUENCE_TITLE_EXCLUDES=


##############################
# Local file sources (docsearch)
##############################

# Comma-separated. Default is ${DOCSEARCH_DATA_DIR}/docs
# FILE_ROOTS=./data/docs

# Comma-separated glob patterns
# FILE_INCLUDE_GLOBS=**/*.{go,ts,tsx,js,py,rs,java,md,mdx,txt,yaml,yml,json,pdf,png,jpg,jpeg,gif,svg,webp}
# FILE_EXCLUDE_GLOBS=**/{.git,node_modules,dist,build,target}/**


#########################
# Fake Qdrant (vector DB)
#########################

# When enabled, exposes a Qdrant-compatible HTTP shim (in addition to MCP tools).
FAKE_QDRANT_ENABLED=0
FAKE_QDRANT_HTTP_HOST=127.0.0.1
FAKE_QDRANT_HTTP_PORT=6333
FAKE_QDRANT_DATA_DIR=./data/fake-qdrant

# Embedding provider. MCP/HTTP can pass `text` when this is configured.
# FAKE_QDRANT_EMBEDDING_PROVIDER=external
# FAKE_QDRANT_EMBEDDING_BASE_URL=https://server.com/v1/openai
# FAKE_QDRANT_EMBEDDING_MODEL=bge-m3
# FAKE_QDRANT_EMBEDDING_DIM=1024
# FAKE_QDRANT_EMBEDDING_API_KEY=
# FAKE_QDRANT_EMBEDDING_TIMEOUT_MS=30000
# Falls back to OPENAI_EMBED_* when the FAKE_QDRANT_EMBEDDING_* names are unset.
# FAKE_QDRANT_LOCAL_EMBEDDINGS_TARGET=http://127.0.0.1:3100


#####################
# central-mcp server #
#####################

PORT=3300
# Semicolon-separated on Windows, colon-separated on Unix
# FILESYSTEM_ALLOWED_DIRS=C:\\DEVHOME\\GITHUB


################
# Memory server #
################

# MEMORY_FILE_PATH=./data/memory.json
