# Root configuration for running MCP servers from this repo.
# Copy to .env (or .env.local) and fill in secrets as needed.
#
# Notes:
# - Keep .env out of git (it contains tokens).
# - This repo is designed to work in offline/locked-down environments.
# - Local embedding models must be pre-downloaded into MODEL_CACHE_DIR / LOCAL_MODEL_CACHE_DIR.
#

############################
# Docsearch: data locations #
############################

# Base directory for docsearch data (docs, urls.md, index.db, etc.)
DOCSEARCH_DATA_DIR=./data

# Optional: override the sqlite db path directly (default: ${DOCSEARCH_DATA_DIR}/index.db)
# DB_PATH=./data/index.db


#########################
# Embeddings: selection #
#########################

# local | openai | tei
EMBEDDINGS_PROVIDER=local

# Local embeddings (docsearch LocalEmbedder)
LOCAL_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
LOCAL_EMBED_DIM=384
LOCAL_MODEL_CACHE_DIR=./model-cache

# Alternative local embeddings model (BGE-M3, 1024 dimensions)
# LOCAL_EMBED_MODEL=Xenova/bge-m3
# LOCAL_EMBED_DIM=1024

# OpenAI-compatible embeddings (docsearch OpenAIEmbedder)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_EMBED_DIM=1536

# TEI (Text Embeddings Inference) endpoint for embeddings (docsearch TEIEmbedder)
# TEI_ENDPOINT=http://127.0.0.1:8080/embed


##############################################
# Local-embeddings server (MCP + offline mode) #
##############################################

# These are used by src/local-embeddings/*
# MODEL_ID defaults to Xenova/all-MiniLM-L6-v2
MODEL_ID=Xenova/all-MiniLM-L6-v2
# MODEL_ASSETS_DIR is the preferred name; MODEL_CACHE_DIR is accepted as fallback.
MODEL_ASSETS_DIR=./model-cache
MODEL_CACHE_DIR=./model-cache
EMBED_CACHE_SIZE=1000
EMBED_CONCURRENCY=2


########################
# LLM (OpenAI-compatible)
########################

# Used by docsearch query expansion and reranking.
# Requires OPENAI_API_KEY (and optionally OPENAI_BASE_URL).
OPENAI_QUERY_EXPANSION_MODEL=gpt-4o-mini
OPENAI_RERANK_MODEL=gpt-4o-mini


##########################
# Image-to-text (optional)
##########################

ENABLE_IMAGE_TO_TEXT=false
IMAGE_TO_TEXT_PROVIDER=openai
IMAGE_TO_TEXT_MODEL=gpt-4o-mini


#######################
# Confluence (optional)
#######################

# CONFLUENCE_BASE_URL=
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# basic | bearer
# CONFLUENCE_AUTH_METHOD=basic
# Comma-separated
# CONFLUENCE_SPACES=

# Optional filters (comma-separated)
# CONFLUENCE_PARENT_PAGES=
# CONFLUENCE_TITLE_INCLUDES=
# CONFLUENCE_TITLE_EXCLUDES=


##############################
# Local file sources (docsearch)
##############################

# Comma-separated. Default is ${DOCSEARCH_DATA_DIR}/docs
# FILE_ROOTS=./data/docs

# Comma-separated glob patterns
# FILE_INCLUDE_GLOBS=**/*.{go,ts,tsx,js,py,rs,java,md,mdx,txt,yaml,yml,json,pdf,png,jpg,jpeg,gif,svg,webp}
# FILE_EXCLUDE_GLOBS=**/{.git,node_modules,dist,build,target}/**


#########################
# Fake Qdrant (vector DB)
#########################

# When enabled, exposes a Qdrant-compatible HTTP shim (in addition to MCP tools).
FAKE_QDRANT_ENABLED=0
FAKE_QDRANT_HTTP_HOST=127.0.0.1
FAKE_QDRANT_HTTP_PORT=6333
FAKE_QDRANT_DATA_DIR=./data/fake-qdrant

# Embedding provider: "local" (uses local-embeddings server) or "external" (OpenAI-compatible API).
FAKE_QDRANT_EMBEDDING_PROVIDER=local
# External mode: base URL and model (must be bge-large-en-v1.5-ITG).
# FAKE_QDRANT_EMBEDDING_BASE_URL=
# FAKE_QDRANT_EMBEDDING_MODEL=bge-large-en-v1.5-ITG
# Local mode: target URL for the local-embeddings HTTP wrapper.
# FAKE_QDRANT_LOCAL_EMBEDDINGS_TARGET=http://127.0.0.1:3000


#####################
# central-mcp server #
#####################

PORT=3300
# Semicolon-separated on Windows, colon-separated on Unix
# FILESYSTEM_ALLOWED_DIRS=C:\\DEVHOME\\GITHUB


##############################################
# embeddings-http-server (OpenAI-compatible) #
##############################################

EMBEDDINGS_HTTP_HOST=127.0.0.1
EMBEDDINGS_HTTP_PORT=3000


################
# Memory server #
################

# MEMORY_FILE_PATH=./data/memory.json
