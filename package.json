{
  "name": "@modelcontextprotocol/servers",
  "private": true,
  "version": "0.6.2",
  "description": "Model Context Protocol servers",
  "license": "MIT",
  "author": "Anthropic, PBC (https://anthropic.com)",
  "homepage": "https://modelcontextprotocol.io",
  "bugs": "https://github.com/modelcontextprotocol/servers/issues",
  "type": "module",
  "workspaces": [
    "src/*"
  ],
  "files": [],
  "scripts": {
    "build": "npm run build --workspaces",
    "watch": "npm run watch --workspaces",
    "publish-all": "npm publish --workspaces --access public",
    "link-all": "npm link --workspaces",
    "validate:mcp": "node scripts/validate_mcps.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server-docsearch": "*",
    "@modelcontextprotocol/server-everything": "*",
    "@modelcontextprotocol/server-filesystem": "*",
    "@modelcontextprotocol/server-local-embeddings": "*",
    "@modelcontextprotocol/server-memory": "*",
    "@modelcontextprotocol/server-sequential-thinking": "*",
    "@modelcontextprotocol/server-fake-qdrant": "*",
    "sharp": "file:vendor/sharp-stub"
  },
  "overrides": {
    "sharp": "$sharp",
    "@xenova/transformers": "2.17.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "protobufjs": "8.7.2",
    "brace-expansion@2": "2.1.4",
    "vitest": "3.2.7",
    "@vitest/coverage-v8": "3.2.7"
  }
}
