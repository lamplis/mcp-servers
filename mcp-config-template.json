{
  "mcpServers": {
    "central-memory": {
      "$comment": "Knowledge graph memory server (JSONL, no database)",
      "command": "npx",
      "args": ["tsx", "src/memory/index.ts"],
      "cwd": "<MCP_SERVERS_PATH>",
      "disabled": false,
      "alwaysAllow": []
    },
    "central-filesystem": {
      "$comment": "Filesystem server - set the allowed root directory",
      "command": "npx",
      "args": ["tsx", "src/filesystem/index.ts", "<ALLOWED_PATH>"],
      "cwd": "<MCP_SERVERS_PATH>",
      "disabled": false,
      "alwaysAllow": []
    },
    "central-everything": {
      "$comment": "MCP demo/test server (use get-env for diagnosis)",
      "command": "npx",
      "args": ["tsx", "src/everything/index.ts", "stdio"],
      "cwd": "<MCP_SERVERS_PATH>",
      "disabled": false,
      "alwaysAllow": ["get-env"]
    },
    "central-sequentialthinking": {
      "$comment": "Sequential thinking/reasoning server",
      "command": "npx",
      "args": ["tsx", "src/sequentialthinking/index.ts"],
      "cwd": "<MCP_SERVERS_PATH>",
      "disabled": false,
      "alwaysAllow": []
    },
    "central-fake-qdrant": {
      "$comment": "Local Qdrant-compatible vector store (JSONL files + optional HTTP :6333)",
      "command": "npx",
      "args": ["tsx", "src/fake-qdrant/index.ts"],
      "cwd": "<MCP_SERVERS_PATH>",
      "env": {
        "FAKE_QDRANT_ENABLED": "1",
        "FAKE_QDRANT_HTTP_PORT": "6333",
        "FAKE_QDRANT_DATA_DIR": "<MCP_SERVERS_PATH>\\data\\fake-qdrant"
      },
      "disabled": false,
      "alwaysAllow": [
        "fake_qdrant_list_collections",
        "fake_qdrant_get_collection",
        "fake_qdrant_create_collection",
        "fake_qdrant_delete_collection",
        "fake_qdrant_upsert_points",
        "fake_qdrant_query_points",
        "fake_qdrant_compact_collection",
        "fake_qdrant_persist_indexes"
      ]
    },
    "central-local-embeddings": {
      "$comment": "Local Transformers.js embeddings (optional OpenAI-compatible HTTP :3100)",
      "command": "npx",
      "args": ["tsx", "src/local-embeddings/index.ts"],
      "cwd": "<MCP_SERVERS_PATH>",
      "env": {
        "MODEL_ID": "Xenova/all-MiniLM-L6-v2",
        "MODEL_CACHE_DIR": "<MCP_SERVERS_PATH>\\model-cache",
        "MODEL_ASSETS_DIR": "<MCP_SERVERS_PATH>\\model-cache",
        "EMBEDDINGS_HTTP_PORT": "3100",
        "EMBEDDINGS_HTTP_HOST": "127.0.0.1"
      },
      "disabled": false,
      "alwaysAllow": ["embeddings", "prefetch_model", "health"]
    },
    "central-docsearch": {
      "$comment": "Document search with in-process local embeddings (JSON index, no SQLite)",
      "command": "npx",
      "args": ["tsx", "src/docsearch/index.ts"],
      "cwd": "<MCP_SERVERS_PATH>",
      "env": {
        "EMBEDDINGS_PROVIDER": "local",
        "DOCSEARCH_DATA_DIR": "<PROJECT_PATH>\\.roo\\docsearch-data",
        "LOCAL_EMBED_MODEL": "Xenova/all-MiniLM-L6-v2",
        "LOCAL_MODEL_CACHE_DIR": "<MCP_SERVERS_PATH>\\model-cache"
      },
      "disabled": false,
      "alwaysAllow": ["doc-search", "doc-ingest", "doc-ingest-status"]
    }
  }
}
