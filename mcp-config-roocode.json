{
  "mcpServers": {
    "central-memory": {
      "$comment": "Auto-start: Knowledge graph memory server",
      "command": "npx",
      "args": ["tsx", "src/memory/index.ts"],
      "cwd": "C:\\DEVHOME\\GITHUB\\mcp-servers",
      "disabled": false,
      "alwaysAllow": []
    },
    "central-filesystem": {
      "$comment": "Auto-start: Filesystem server with access to DEVHOME",
      "command": "npx",
      "args": ["tsx", "src/filesystem/index.ts", "C:\\DEVHOME"],
      "cwd": "C:\\DEVHOME\\GITHUB\\mcp-servers",
      "disabled": false,
      "alwaysAllow": []
    },
    "central-everything": {
      "$comment": "Auto-start: MCP demo/test server with all capabilities",
      "command": "npx",
      "args": ["tsx", "src/everything/index.ts", "stdio"],
      "cwd": "C:\\DEVHOME\\GITHUB\\mcp-servers",
      "disabled": false,
      "alwaysAllow": ["get-env"]
    },
    "central-sequentialthinking": {
      "$comment": "Auto-start: Sequential thinking/reasoning server",
      "command": "npx",
      "args": ["tsx", "src/sequentialthinking/index.ts"],
      "cwd": "C:\\DEVHOME\\GITHUB\\mcp-servers",
      "disabled": false,
      "alwaysAllow": []
    },
    "central-fake-qdrant": {
      "$comment": "Auto-start: Fake Qdrant JSONL vector store with HTTP shim on port 6333",
      "command": "npx",
      "args": ["tsx", "src/fake-qdrant/index.ts"],
      "cwd": "C:\\DEVHOME\\GITHUB\\mcp-servers",
      "env": {
        "FAKE_QDRANT_ENABLED": "1",
        "FAKE_QDRANT_HTTP_PORT": "6333",
        "FAKE_QDRANT_DATA_DIR": "C:\\DEVHOME\\GITHUB\\mcp-servers\\data\\fake-qdrant"
      },
      "disabled": false,
      "alwaysAllow": [
        "fake_qdrant_list_collections",
        "fake_qdrant_get_collection",
        "fake_qdrant_create_collection",
        "fake_qdrant_delete_collection",
        "fake_qdrant_upsert_points",
        "fake_qdrant_query_points",
        "fake_qdrant_compact_collection",
        "fake_qdrant_persist_indexes"
      ]
    },
    "central-local-embeddings": {
      "$comment": "Auto-start: Local embeddings (Transformers.js) with HTTP on port 3100",
      "command": "npx",
      "args": ["tsx", "src/local-embeddings/index.ts"],
      "cwd": "C:\\DEVHOME\\GITHUB\\mcp-servers",
      "env": {
        "MODEL_ID": "Xenova/all-MiniLM-L6-v2",
        "MODEL_CACHE_DIR": "C:\\DEVHOME\\GITHUB\\mcp-servers\\model-cache",
        "MODEL_ASSETS_DIR": "C:\\DEVHOME\\GITHUB\\mcp-servers\\model-cache",
        "EMBEDDINGS_HTTP_PORT": "3100",
        "EMBEDDINGS_HTTP_HOST": "127.0.0.1"
      },
      "disabled": false,
      "alwaysAllow": ["embeddings", "prefetch_model", "health"]
    },
    "central-docsearch": {
      "$comment": "Auto-start: Document search with local embeddings (JSON index, no SQLite)",
      "command": "npx",
      "args": ["tsx", "src/docsearch/index.ts"],
      "cwd": "C:\\DEVHOME\\GITHUB\\mcp-servers",
      "env": {
        "EMBEDDINGS_PROVIDER": "local",
        "DOCSEARCH_DATA_DIR": "C:\\DEVHOME\\GITHUB\\mcp-servers\\data\\docsearch",
        "LOCAL_EMBED_MODEL": "Xenova/all-MiniLM-L6-v2",
        "LOCAL_MODEL_CACHE_DIR": "C:\\DEVHOME\\GITHUB\\mcp-servers\\model-cache"
      },
      "disabled": false,
      "alwaysAllow": ["doc-search", "doc-ingest", "doc-ingest-status"]
    }
  }
}
