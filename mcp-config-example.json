{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Copy this to .cursor/mcp.json for auto-start MCP servers. All 'command' type servers auto-start via stdio. Or run: python scripts/setup_roo.py",
  "mcpServers": {
    "central-memory": {
      "$comment": "Auto-start: Knowledge graph memory server",
      "command": "node",
      "args": ["scripts/mcp-launch.mjs", "memory"],
      "env": { "MCP_TAKEOVER": "1" }
    },
    "central-filesystem": {
      "$comment": "Auto-start: Filesystem server. Replace <YOUR_ALLOWED_DIR> with allowed paths",
      "command": "node",
      "args": ["scripts/mcp-launch.mjs", "filesystem", "<YOUR_ALLOWED_DIR>"]
    },
    "central-everything": {
      "$comment": "Auto-start: MCP demo/test server with all capabilities",
      "command": "node",
      "args": ["scripts/mcp-launch.mjs", "everything", "stdio"]
    },
    "central-sequentialthinking": {
      "$comment": "Auto-start: Sequential thinking/reasoning server",
      "command": "node",
      "args": ["scripts/mcp-launch.mjs", "sequentialthinking"]
    },
    "central-fake-qdrant": {
      "$comment": "Auto-start: Fake Qdrant JSONL store with optional HTTP shim on port 6333",
      "command": "node",
      "args": ["scripts/mcp-launch.mjs", "fake-qdrant"],
      "env": {
        "FAKE_QDRANT_ENABLED": "1",
        "FAKE_QDRANT_HTTP_PORT": "6333",
        "FAKE_QDRANT_DATA_DIR": "./data/fake-qdrant",
        "MCP_TAKEOVER": "1"
      }
    },
    "central-local-embeddings": {
      "$comment": "Auto-start: Local embeddings (Transformers.js) with optional HTTP on port 3100",
      "command": "node",
      "args": ["scripts/mcp-launch.mjs", "local-embeddings"],
      "env": {
        "MODEL_ID": "Xenova/all-MiniLM-L6-v2",
        "MODEL_CACHE_DIR": "./model-cache",
        "MODEL_ASSETS_DIR": "./model-cache",
        "EMBEDDINGS_HTTP_PORT": "3100",
        "EMBEDDINGS_HTTP_HOST": "127.0.0.1"
      }
    },
    "central-docsearch": {
      "$comment": "Auto-start: Document search with local embeddings (JSON index, no SQLite)",
      "command": "node",
      "args": ["scripts/mcp-launch.mjs", "docsearch"],
      "env": {
        "EMBEDDINGS_PROVIDER": "local",
        "DOCSEARCH_DATA_DIR": "./data/docsearch",
        "LOCAL_EMBED_MODEL": "Xenova/all-MiniLM-L6-v2",
        "LOCAL_MODEL_CACHE_DIR": "./model-cache",
        "MCP_TAKEOVER": "1"
      }
    }
  }
}
